{
  "name": "@jesdi/skills",
  "version": "0.0.29",
  "description": "jesdi's agent skills (content package consumed by @jesdi/skills-cli)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jesdi/general-skills.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "files": [
    "skills",
    "skills-manifest.json"
  ],
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reportOnFailure",
    "test:python": "mkdir -p .crap && python3 -m coverage run -m pytest skills/backlog skills/crap-gate -q && python3 -m coverage json -o .crap/python.json",
    "crap-gate": "sh skills/crap-gate/run.sh",
    "check": "sh scripts/check.sh",
    "generate-manifest": "tsx scripts/generate-manifest.ts"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@vitest/coverage-istanbul": "2.1.9",
    "gray-matter": "^4.0.3",
    "jsdom": "^30.1.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
